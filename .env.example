# Copie para .env.local (desenvolvimento) ou configure na hospedagem.

# Chave usada para criptografar webhooks e tokens do Bitrix24 e assinar as sessões.
# Use um texto aleatório longo (32+ caracteres). Se não for definida, o app gera uma
# automaticamente em ./data/.app-secret na primeira execução.
APP_SECRET=

# Endereço público do app (HTTPS), usado ao criar a aba no cadastro da empresa.
# Opcional: sem ele, o app usa o endereço da própria requisição.
APP_URL=

# Pasta dos dados (banco SQLite, cache e logs). Padrão: ./data
# DATA_DIR=./data

# Domínios extras autorizados a abrir o app em iframe (portais Bitrix24 com domínio próprio).
# FRAME_ANCESTORS=https://crm.minhaempresa.com.br
